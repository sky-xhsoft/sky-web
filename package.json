{
  "name": "sky-web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc -b --noCheck",
    "build:no-typecheck": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lint": "eslint \"src/**/*.{ts,vue}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,scss,md}\""
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@vue-office/docx": "^1.6.3",
    "@vue-office/excel": "^1.7.14",
    "@wangeditor/editor": "^5.1.23",
    "axios": "^1.13.2",
    "dompurify": "^3.2.4",
    "echarts": "^6.0.0",
    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.22",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "playwright": "^1.57.0",
    "spark-md5": "^3.0.2",
    "vue": "^3.5.24",
    "vue-i18n": "^10.0.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/lodash-es": "^4.17.12",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.10.1",
    "@types/spark-md5": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.1.0",
    "jsdom": "^27.0.1",
    "less": "^4.5.1",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.17",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.1.4"
  }
}
