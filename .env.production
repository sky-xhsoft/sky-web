# 生产环境 (web.zigebo.com)
# API 走同域名 nginx 反代 -> 相对路径，避免写死域名
VITE_API_BASE_URL=/api/v1

# Default live domain configuration
VITE_DEFAULT_PUSH_DOMAIN=upload.zigebo.com
VITE_DEFAULT_PLAY_DOMAIN=live.zigebo.com
VITE_DEFAULT_LIVE_APP=live
# Stream key removed - should come from backend API if needed
