# 前端环境变量示例
# 本地开发复制为 .env.development.local；测试环境用 .env.test（不提交），正式环境用 .env.production

# 接口地址；部署在 nginx 后用相对路径 /api/v1
VITE_API_BASE_URL=/api/v1
# 开发服务器 /api 代理的后端地址（npm run dev 时使用，默认 http://localhost:9090）
VITE_API_PROXY_TARGET=http://localhost:9090

# 默认直播域名
VITE_DEFAULT_PUSH_DOMAIN=upload.example.com
VITE_DEFAULT_PLAY_DOMAIN=live.example.com
VITE_DEFAULT_LIVE_APP=live
# 推流密钥不放在前端配置里（VITE_DEFAULT_STREAM_KEY 已废弃）
# 腾讯云播放器 License（按域名校验）
# 测试与正式 License 分别在腾讯云「Web License 管理」中申请
VITE_TCPLAYER_LICENSE_URL=https://<appid>.trtcube-license.cn/license/v2/<appid>_1/v_cube.license
