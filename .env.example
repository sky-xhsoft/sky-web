# Frontend Environment Variables
# Copy to .env.production or .env.development.local

# API Base URL
VITE_API_BASE_URL=http://localhost:9090/api/v1

# Live Streaming Configuration
VITE_DEFAULT_PUSH_DOMAIN=upload.example.com
VITE_DEFAULT_PLAY_DOMAIN=live.example.com
VITE_DEFAULT_LIVE_APP=live
# Stream key should NOT be in frontend config
# VITE_DEFAULT_STREAM_KEY=your-stream-key (deprecated)
